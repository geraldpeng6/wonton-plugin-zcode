#!/usr/bin/env python3
"""Coding Plan key 登录：从 stdin 读一行 key，写进 CLI 的个人模型配置（0600）和桥读的凭据配置。

参数是 zai 或 bigmodel，决定去哪家官方端点。网关接着的时候默认模型留在网关上，卸掉网关后重启就轮到这个 key。
"""
import json
import os
import sys
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
V2 = HOME / ".zcode" / "v2"
PROVIDERS = V2 / "provider_config.json"
CREDENTIALS = V2 / "config.json"

GATEWAY = "wonton-gateway"
MODELS = ["GLM-5.3", "GLM-5.3-Flash"]
FAMILIES = {
    "zai": ("Z.ai Coding Plan", "https://api.z.ai/api/anthropic"),
    "bigmodel": ("BigModel Coding Plan", "https://open.bigmodel.cn/api/anthropic"),
}


def die(message: str) -> None:
    print(f"登录失败：{message}", file=sys.stderr)
    raise SystemExit(1)


def load(path: Path) -> dict:
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except ValueError as error:
        die(f"{path} 不是合法 JSON（{error}）")
    if not isinstance(data, dict):
        die(f"{path} 顶层不是对象")
    return data


def save(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    temporary.chmod(0o600)
    os.replace(temporary, path)


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in FAMILIES:
        die(f"用法：{sys.argv[0]} zai|bigmodel")
    family = sys.argv[1]
    name, base_url = FAMILIES[family]
    provider_id = f"coding-plan-{family}"

    print(f"粘贴 {name} 的 API key 后回车：", flush=True)
    key = (sys.stdin.readline() or "").strip()
    if not key or any(character.isspace() for character in key):
        die("没读到 key：先粘贴 Coding Plan 的 API key 再回车")

    data = load(PROVIDERS)
    data.setdefault("schemaVersion", 1)
    config = data.setdefault("config", {})
    rules = config.setdefault("providerConfigRules", {}).setdefault("providerRules", [])
    # 一次只留一个 Coding Plan 来源，免得两个 key 的默认模型互相打架。
    rules[:] = [rule for rule in rules if not str(rule.get("providerId", "")).startswith("coding-plan-")]
    rules.append({
        "providerId": provider_id,
        "providerName": name,
        "config": {
            "group": "standard-personal",
            "access": {"type": "api-key", "apiKey": key},
            "api": {"type": "anthropic-messages", "baseUrl": base_url},
            "personalModelIds": MODELS,
        },
    })
    config.setdefault("modelConfigRules", {
        "providerModelRules": [],
        "manualProviderModelRules": [],
    })
    # 网关接着时默认模型留在网关；重启时钩子的 apply 也会再压一次。
    if not _gateway_there(rules):
        config["defaultModelSelection"] = {"providerId": provider_id, "modelId": MODELS[0]}
    save(PROVIDERS, data)

    credentials = load(CREDENTIALS)
    provider = credentials.get("provider")
    provider = provider if isinstance(provider, dict) else {}
    for stale in [item for item in provider if item.startswith("coding-plan-")]:
        del provider[stale]
    entry = {
        "enabled": True,
        "name": name,
        "kind": "anthropic",
        "options": {"baseURL": base_url, "apiKey": key},
        "models": {model: {} for model in MODELS},
    }
    if GATEWAY in provider:
        credentials["provider"] = {GATEWAY: provider[GATEWAY], provider_id: entry}
    else:
        credentials["provider"] = {provider_id: entry}
    save(CREDENTIALS, credentials)

    print(f"已保存 {name} 的 key，模型 {MODELS[0]}。Agent 正在重启。")


def _gateway_there(rules: list) -> bool:
    return any(rule.get("providerId") == GATEWAY for rule in rules)


main()
