#!/usr/bin/env python3
"""登录状态：退出码 0 = 已登录，1 = 没登录，网页的登录列表按这个显示。参数是 类型 和 站点。

账号看凭据文件里的 token 键，key 看个人配置里的对应 provider。有记录不代表 token 没过期。
"""
import json
import os
import sys
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
V2 = HOME / ".zcode" / "v2"


def logged_in(kind: str, family: str) -> bool:
    try:
        if kind == "account":
            credentials = json.loads((V2 / "credentials.json").read_text())
            return bool(credentials.get(f"oauth:{family}:access_token"))
        providers = json.loads((V2 / "provider_config.json").read_text())
        rules = providers["config"]["providerConfigRules"]["providerRules"]
        return any(
            rule.get("providerId") == f"coding-plan-{family}"
            and (rule.get("config", {}).get("access", {}) or {}).get("apiKey")
            for rule in rules
        )
    except (OSError, ValueError, KeyError, TypeError):
        return False


if len(sys.argv) != 3 or sys.argv[1] not in ("account", "coding-plan") or sys.argv[2] not in ("zai", "bigmodel"):
    print(f"用法：{sys.argv[0]} account|coding-plan zai|bigmodel", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(0 if logged_in(sys.argv[1], sys.argv[2]) else 1)
